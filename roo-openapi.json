      "in": "header"
    }
  },
  "definitions": {
    "Empty": {
      "type": "object",
      "title": "Empty Schema"
    },
    "Shortlink": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The destination URL"
        },
        "addOns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AddOn"
          }
        },
        "customDomain": {
          "$ref": "#/definitions/CustomDomain"
        }
      },
      "required": [
        "url"
      ]
    },
    "AddOn": {
      "type": "object",
      "discriminator": "addOn",
      "required": [
        "addOn",
        "enabled",
        "data"
      ],
      "properties": {
        "addOn": {
          "type": "string",
          "description": "Type of the add-on",
          "enum": [
            "scheduledRedirect",
            "clickCountRedirect",
            "webhook",
            "previewLink",
            "qrCode"
          ]
        },
        "enabled": {
          "type": "boolean",
          "description": "Used to enable/disable the add-on"
        },
        "data": {
          "type": "object",
          "description": "Payload depends on the value of addOn"
        }
      }
    },
    "AddOnScheduledRedirect": {
      "allOf": [
        {
          "$ref": "#/definitions/AddOn"
        },
        {
          "type": "object",
          "properties": {
            "addOn": {
              "type": "string",
              "enum": [
                "scheduledRedirect"
              ]
            },
            "data": {
              "$ref": "#/definitions/ScheduledRedirectData"
            }
          }
        }
      ]
    },
    "AddOnClickCountRedirect": {
      "allOf": [
        {
          "$ref": "#/definitions/AddOn"
        },
        {
          "type": "object",
          "properties": {
            "addOn": {
              "type": "string",
              "enum": [
                "clickCountRedirect"
              ]
            },
            "data": {
              "$ref": "#/definitions/ClickCountRedirectData"
            }
          }
        }
      ]
    },
    "AddOnWebhook": {
      "allOf": [
        {
          "$ref": "#/definitions/AddOn"
        },
        {
          "type": "object",
          "properties": {
            "addOn": {
              "type": "string",
              "enum": [
                "webhook"
              ]
            },
            "data": {
              "$ref": "#/definitions/WebhookData"
            }
          }
        }
      ]
    },
    "AddOnPreviewLink": {
      "allOf": [
        {
          "$ref": "#/definitions/AddOn"
        },
        {
          "type": "object",
          "properties": {
            "addOn": {
              "type": "string",
              "enum": [
                "previewLink"
              ]
            },
            "data": {
              "$ref": "#/definitions/PreviewLinkData"
            }
          }
        }
      ]
    },
    "AddOnQrCode": {
      "allOf": [
        {
          "$ref": "#/definitions/AddOn"
        },
        {
          "type": "object",
          "properties": {
            "addOn": {
              "type": "string",
              "enum": [
                "qrCode"
              ]
            },
            "data": {
              "$ref": "#/definitions/QrCodeData"
            }
          }
        }
      ]
    },
    "ScheduledRedirectItem": {
      "type": "object",
      "required": [
        "timestamp",
        "url"
      ],
      "properties": {
        "timestamp": {
          "type": "integer",
          "format": "int64",
          "description": "Unix epoch timestamp (seconds) when redirect takes effect",
          "example": 1780132320
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Destination URL at this schedule point",
          "example": "https://test.com"
        }
      }
    },
    "ScheduledRedirectData": {
      "type": "object",
      "required": [
        "schedule"
      ],
      "properties": {
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ScheduledRedirectItem"
          }
        }
      }
    },
    "ClickCountRedirectItem": {
      "type": "object",
      "required": [
        "clickCount",
        "url"
      ],
      "properties": {
        "clickCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Redirect after this many clicks",
          "example": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Destination URL at this click threshold",
          "example": "https://test.com"
        }
      }
    },
    "ClickCountRedirectData": {
      "type": "object",
      "required": [
        "schedule"
      ],
      "properties": {
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ClickCountRedirectItem"
          }
        }
      }
    },
    "WebhookData": {
      "type": "object",
      "required": [
        "name",
        "method",
        "body",
        "contentType",
        "endpoint",
        "addMetadata",
        "headers",
        "queryString"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for the webhook",
          "example": "Test"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ],
          "example": "POST"
        },
        "body": {
          "type": "string",
          "description": "Request body content (JSON string, form data, etc.)",
          "example": "{\n  \"abc\": \"value\"\n}"
        },
        "contentType": {
          "type": "string",
          "enum": [
            "application/json",
            "application/x-www-form-urlencoded",
            "multipart/form-data",
            "application/xml",
            "text/plain",
            "application/octet-stream"
          ],
          "example": "application/json"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Webhook target URL",
          "example": "https://test.com"
        },
        "addMetadata": {
          "type": "boolean",
          "description": "Include shortlink metadata in the webhook payload",
          "example": true
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Custom HTTP headers",
          "example": {}
        },
        "queryString": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Query string parameters appended to the endpoint",
          "example": {}
        }
      }
    },
    "PreviewLinkData": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "image": {
          "type": "string",
          "description": "Base64 data URI when uploading a new image (e.g. data:image/png;base64,...)"
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "description": "Hosted image URL returned by the server; send back when not changing the image"
        },
        "title": {
          "type": "string",
          "example": "test title"
        },
        "description": {
          "type": "string",
          "example": "test description"
        }
      }
    },
    "QrCodeData": {
      "type": "object",
      "required": [
        "codeColor",
        "backgroundColor",
        "qtType",
        "scale",
        "logo",
        "displayRooLogo"
      ],
      "properties": {
        "codeColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "QR code foreground color (hex)",
          "example": "#58CB96"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "QR code background color (hex)",
          "example": "#FFFFFF"
        },
        "qtType": {
          "type": "string",
          "enum": [
            "mode_1",
            "mode_2",
            "mode_3",
            "mode_4",
            "mode_5",
            "mode_6",
            "mode_7",
            "mode_8",
            "mode_9"
          ],
          "description": "QR code dot/corner style pattern",
          "example": "mode_6"
        },
        "scale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "QR code size multiplier",
          "example": 1
        },
        "logo": {
          "type": "string",
          "description": "Center logo as base64 data URI; empty string if no logo",
          "example": ""
        },
        "displayRooLogo": {
          "type": "boolean",
          "description": "Show Roo branding on the QR code",
          "example": false
        }
      }
    },
    "CustomDomain": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "description": "Your verified custom domain"
        },
        "slug": {
          "type": "string",
          "description": "The back part of the shortlink, must be unique for the selected custom domain"
        },
        "alternativeSlug": {
          "type": "boolean",
          "description": "When the selected slug already exists then if this flag is true then resort to a random string, else error out"
        }
      }
    },
    "ShortlinkRecordAttribs": {
      "type": "object",
      "properties": {
        "UserId": {
          "type": "string",
          "description": "Creator User ID"
        },
        "TargetUrl": {
          "type": "string",
          "description": "Destination URL"
        }
      }
    },
    "ShortlinkRecord": {
      "type": "object",
      "properties": {
        "CreatedDate": {
          "type": "number",
          "description": "Shortlink create epoch timestamp"
        },
        "UpdatedDate": {
          "type": "number",
          "description": "Shortlink update epoch timestamp"
        },
        "Attributes": {
          "$ref": "#/definitions/ShortlinkRecordAttribs"
        },
        "Counter": {
          "type": "number",
          "description": "Shortlink visit counter"
        },
        "addOns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AddOn"
          }
        },
        "customDomain": {
          "$ref": "#/definitions/CustomDomain"
        }
      }
    },
    "ShortlinkRecordList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShortlinkRecord"
          },
          "description": "Shortlinks array"
        },
        "nextKey": {
          "type": "string",
          "description": "Key for requesting the next page of results"
        }
      }
    },
    "ShortlinkCreated": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "shortUrl": {
          "type": "string",
          "description": "The created shortlink"
        },
        "message": {
          "type": "string",
          "description": "system message when required"
        }
      }
    },
    "ShortlinkUpdated": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "description": "system message when required"
        }
      }
    }
  }
}
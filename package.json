{
  "name": "@roo-bz/roo-mcp",
  "version": "0.1.1",
  "description": "MCP server for the Roo (roo.bz) smart-shortlink API — create, manage, and configure add-ons (scheduled/click-count redirects, webhooks, preview links, QR codes) on Roo shortlinks from any MCP-capable AI client.",
  "type": "module",
  "bin": {
    "roo-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "dev": "tsx ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "roo",
    "roo.bz",
    "shortlinks",
    "shortener",
    "qr",
    "webhook",
    "claude"
  ],
  "license": "MIT",
  "author": "David Zisner <support@roo.bz>",
  "homepage": "https://github.com/dzisner/roo-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzisner/roo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dzisner/roo-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
